---
const liveTickerData = [
  {
    message: `Die DB-Schnittstelle antwortet auf bestimmte Anfragen mit HTTP 452 (OPS_BLOCKED). Hinweise deuten darauf hin, dass der Bot-Schutz diese Anfragen blockiert. Wir testen eine technische Anpassung.`,
    time: "9.10.2026",
  },
];

const buttonLink = "/DBFuckedUp";
---

<div class="mt-16 flex justify-center">
  <div class="w-full max-w-md bg-red-900 text-white rounded-lg shadow-lg p-6 border border-red-700">
    <!-- Image -->
    <div class="flex justify-center">
      <img 
        src="/images/DBFuckedUp.png"
        alt="Server Issue" 
        class="w-24 h-24 object-contain" 
      />
    </div>
    
    <!-- Title -->
    <h2 class="text-center text-xl font-semibold mt-4">DB-Verkehrsnetz vorübergehend gestört</h2>
    
    <!-- Description -->
    <p class="text-center text-sm mt-2 leading-relaxed">
      Bei der DB-Schnittstelle gibt es derzeit Probleme. Abfahrten, Ankünfte und die Verbindungssuche im DB-Verkehrsnetz funktionieren nicht zuverlässig. Die Suche nach Stationen in der Nähe kann weiterhin funktionieren. Wir arbeiten an einer Lösung.
    </p>
    
    <!-- News Ticker (List with Timestamps) -->
    <ul class="mt-4 bg-red-800 rounded-md py-4 px-6 space-y-4">
      {liveTickerData.map((item, index) => (
        <li key={index} class="flex flex-col text-sm">
          <span class="flex gap-2 items-center">
            <span class="w-2 h-2 bg-white rounded-full flex-shrink-0"></span>
            <span class="flex-grow">{item.message}</span>
          </span>
          <span class="text-gray-300 text-xs mt-1 ml-4">{item.time}</span>
        </li>
      ))}
    </ul>

    <!-- Button -->
    <div class="mt-6 flex justify-center">
      <a
        href={buttonLink}
        class="bg-red-700 hover:bg-red-600 text-white font-semibold py-2 px-4 rounded-md shadow-md transition duration-200"
      >
        E-Mail Updates abonnieren
      </a>
    </div>
  </div>
</div>
