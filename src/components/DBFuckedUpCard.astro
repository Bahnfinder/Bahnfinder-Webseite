---
// Karte für eine Störung aus notices.json
const { incident, alt } = Astro.props;

// Rot während einer Störung, grün wenn behoben
const colors = incident.status === "ongoing"
  ? { card: "bg-red-900 border-red-700", ticker: "bg-red-800", details: "bg-red-800/60", button: "bg-red-700 hover:bg-red-600" }
  : { card: "bg-green-900 border-green-700", ticker: "bg-green-800", details: "bg-green-800/60", button: "bg-green-700 hover:bg-green-600" };
---

<div class="mt-16 flex justify-center">
  <div class={`w-full max-w-md text-white rounded-lg shadow-lg p-6 border ${colors.card}`}>
    <!-- Image -->
    <div class="flex justify-center">
      <img
        src={incident.image}
        alt={alt}
        class="w-24 h-24 object-contain"
      />
    </div>

    <!-- Title -->
    <h2 class="text-center text-xl font-semibold mt-4">{incident.title}</h2>

    <!-- Description -->
    <p class="text-center text-sm mt-2 leading-relaxed">
      {incident.description}
    </p>

    <!-- News Ticker (List with Timestamps) -->
    <ul class={`mt-4 ${colors.ticker} rounded-md py-4 px-6 space-y-4`}>
      {incident.liveTicker.map((item, index) => (
        <li key={index} class="flex flex-col text-sm">
          <span class="flex gap-2 items-center">
            <span class="w-2 h-2 bg-white rounded-full flex-shrink-0"></span>
            <span class="flex-grow">
              {item.message}
              {item.subtitle && (
                <span class="mt-1 block secondaryLabelColor">{item.subtitle}</span>
              )}
            </span>
          </span>
          <span class="text-gray-300 text-xs mt-1 ml-4">{item.time}</span>
        </li>
      ))}
    </ul>

    {incident.technicalDetails && (
      <details class={`mt-4 rounded-md ${colors.details} px-4 py-3`}>
        <summary class="cursor-pointer text-sm font-semibold secondaryLabelColor">
          {incident.technicalDetails.title ?? "Technische Details"}
        </summary>
        {incident.technicalDetails.paragraphs.map((paragraph) => (
          <p class="mt-3 text-sm leading-relaxed secondaryLabelColor">
            {paragraph.split("`").map((part, index) => (
              index % 2 === 1 ? <code class="rounded bg-black/30 px-1.5 py-0.5">{part}</code> : part
            ))}
          </p>
        ))}
      </details>
    )}

    <!-- Button -->
    {incident.button && (
      <div class="mt-6 flex justify-center">
        <a
          href={incident.button.url}
          class={`${colors.button} text-white font-semibold py-2 px-4 rounded-md shadow-md transition duration-200`}
        >
          {incident.button.title}
        </a>
      </div>
    )}
  </div>
</div>
